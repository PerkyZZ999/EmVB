---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { releaseLabel } from "../data/changelog";
import Base from "../layouts/Base.astro";
// Rendered from the repository's CHANGELOG.md at build time, so the page never drifts from it (W-322).
import { Content, getHeadings } from "../../../CHANGELOG.md";

// One entry per release ("[0.2.1] - 2026-10-08", "[Unreleased]") for the version list.
const versions = getHeadings()
  .filter((heading) => heading.depth === 2)
  .map((heading) => ({ slug: heading.slug, ...releaseLabel(heading.text) }));
---

<Base
  title="Changelog · EmVB"
  description="Every EmVB release: what was added, changed and fixed, with accessibility, performance, security and breaking changes."
>
  <SiteHeader />
  <main id="content">
    <section class="section blueprint intro">
      <div class="wrap">
        <p class="eyebrow">Releases</p>
        <h1>Changelog</h1>
        <p class="lede">
          Every EmVB release, newest first, in the{" "}
          <a href="https://keepachangelog.com/en/1.1.0/">Keep a Changelog</a> format with{" "}
          <a href="https://semver.org/">semantic versions</a>. Each entry names its work item.
          "Breaking" lists schema changes: a page saved by a newer EmVB can't be opened by an older one.
        </p>
      </div>
    </section>

    <div class="wrap layout">
      <nav class="versions" aria-label="Versions">
        <p class="heading">Versions</p>
        <ol>
          {
            versions.map((entry) => (
              <li>
                <a href={`#${entry.slug}`}>
                  <span class="version">{entry.version}</span>
                  {entry.date && <time datetime={entry.date}>{entry.date}</time>}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <article class="log" data-changelog>
        <Content />
      </article>
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .intro {
    padding-block: var(--space-9) var(--space-7);
  }

  h1 {
    margin-block: var(--space-3);
    font-size: var(--text-display);
  }

  .layout {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: var(--space-8);
    padding-block: var(--space-7) var(--space-9);
  }

  .versions {
    position: sticky;
    top: calc(var(--header-h) + var(--space-5));
    align-self: start;
  }

  .heading {
    margin-bottom: var(--space-2);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .versions ol {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .versions a {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border-inline-start: 2px solid var(--rule);
    color: var(--ink-soft);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-in-out),
      border-color var(--dur-fast) var(--ease-in-out);
  }

  .versions a:hover {
    border-color: var(--accent);
    color: var(--ink);
  }

  .version {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .versions time {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  /* The rendered Markdown. */
  .log {
    max-width: 78ch;
    line-height: 1.65;
  }

  /* The file's own title and format note; the page intro says the same. */
  .log :global(h1),
  .log :global(h1 ~ p:not(h2 ~ p)) {
    display: none;
  }

  .log :global(h2) {
    scroll-margin-top: calc(var(--header-h) + var(--space-5));
    margin-top: var(--space-9);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
    font-size: var(--text-h2);
  }

  .log :global(h2:first-of-type) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .log :global(h2 + p) {
    margin-top: var(--space-3);
  }

  .log :global(h2 a) {
    color: inherit;
    text-decoration: none;
  }

  .log :global(h3) {
    display: inline-flex;
    margin-top: var(--space-7);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .log :global(ul) {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding-inline-start: var(--space-5);
  }

  .log :global(ul ul) {
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .log :global(li::marker) {
    color: var(--ink-faint);
  }

  .log :global(p),
  .log :global(li) {
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  .log :global(strong) {
    color: var(--ink);
  }

  .log :global(code) {
    padding: 0.1em 0.35em;
    border-radius: var(--radius-s);
    background: var(--paper-sunk);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .log :global(a) {
    color: var(--accent);
  }

  @media (max-width: 800px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }

    .versions {
      position: static;
    }

    .versions ol {
      grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    }
  }
</style>
