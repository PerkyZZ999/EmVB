---
/** A quiet browser window around a desktop screenshot, or a phone bezel. */
interface Props {
  label?: string;
  phone?: boolean;
}

const { label, phone = false } = Astro.props;
---

<div class:list={["frame", phone && "frame--phone"]}>
  {
    !phone && (
      <div class="chrome" aria-hidden="true">
        <span class="dots">
          <i />
          <i />
          <i />
        </span>
        {label && <span class="url">{label}</span>}
      </div>
    )
  }
  <div class="screen"><slot /></div>
</div>

<style>
  .frame {
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--paper-raised);
    box-shadow: var(--shadow-frame);
  }

  .chrome {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--space-6);
    padding-inline: var(--space-4);
    border-bottom: 1px solid var(--rule);
    background: var(--paper-sunk);
  }

  .dots {
    display: flex;
    gap: var(--space-2);
  }

  .dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--rule-strong);
  }

  .url {
    padding: 0 var(--space-4);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
    white-space: nowrap;
  }

  .screen :global(img) {
    width: 100%;
  }

  .frame--phone {
    padding: var(--space-2);
    border-radius: 32px;
    background: var(--night);
    border-color: transparent;
  }

  .frame--phone .screen {
    overflow: hidden;
    border-radius: 24px;
  }

  @media (max-width: 560px) {
    .chrome {
      height: var(--space-5);
    }

    .url {
      display: none;
    }
  }
</style>
