---
/**
 * One shared dialog for every link marked data-lightbox. Without JavaScript the
 * links still open the full-size screenshot.
 */
---

<dialog class="lightbox" aria-label="Screenshot">
  <form method="dialog">
    <button class="close" aria-label="Close">×</button>
  </form>
  <img alt="" />
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("dialog.lightbox");
  const image = dialog?.querySelector("img");
  if (dialog && image) {
    for (const link of document.querySelectorAll<HTMLAnchorElement>("a[data-lightbox]")) {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        image.src = link.href;
        image.alt = link.querySelector("img")?.alt ?? "";
        dialog.showModal();
      });
    }
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog || event.target === image) dialog.close();
    });
  }
</script>

<style>
  .lightbox {
    z-index: var(--z-modal);
    width: min(96vw, 1600px);
    max-width: none;
    max-height: 94vh;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: var(--radius-m);
    background: transparent;
  }

  .lightbox[open] {
    animation: pop var(--dur-base) var(--ease-out);
  }

  .lightbox::backdrop {
    background: rgb(10 10 12 / 82%);
    backdrop-filter: blur(4px);
  }

  .lightbox img {
    width: 100%;
    max-height: 94vh;
    object-fit: contain;
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-float);
    cursor: zoom-out;
  }

  .close {
    position: absolute;
    top: calc(var(--space-3) * -1);
    right: calc(var(--space-3) * -1);
    z-index: var(--z-raised);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: var(--shadow-rest);
    color: var(--ink);
    font-size: var(--text-lead);
    line-height: 1;
    cursor: pointer;
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  @media (max-width: 720px) {
    .close {
      top: var(--space-2);
      right: var(--space-2);
    }
  }
</style>
