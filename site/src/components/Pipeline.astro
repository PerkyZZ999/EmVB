---
import { sample, steps } from "../data/pipeline";
import { highlight } from "../scripts/highlight";
import SectionIntro from "./SectionIntro.astro";

const panes = {
  json: highlight(sample.json, "json"),
  html: highlight(sample.html, "html"),
  css: highlight(sample.css, "css"),
};
---

<section class="section night blueprint" aria-labelledby="hood-title">
  <div class="wrap" id="under-the-hood">
    <SectionIntro id="hood-title" eyebrow="Under the hood" title="From canvas to markup in four steps" />

    <ol class="steps">
      {
        steps.map((step, index) => (
          <li class="reveal">
            <span class="node" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="code reveal">
      <figure class="pane">
        <figcaption><span class="file">layout.json</span><span class="badge">stored</span></figcaption>
        <pre><code set:html={panes.json} /></pre>
      </figure>
      <div class="render" aria-hidden="true">
        <span class="beam"></span>
        <span class="fn">renderPage()</span>
        <span class="beam"></span>
      </div>
      <figure class="pane">
        <figcaption><span class="file">page.html + page.css</span><span class="badge badge--live">served</span></figcaption>
        <pre><code set:html={panes.html} /></pre>
        <pre class="css"><code set:html={panes.css} /></pre>
      </figure>
    </div>
    <p class="note">The hero heading of the Northfold demo, as saved and as published (line breaks added).</p>
  </div>
</section>

<style>
  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0 0 var(--space-8);
    padding: 0;
    list-style: none;
  }

  /* The track the four nodes sit on, with a pulse running from Edit to Serve. */
  .steps::before {
    content: "";
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    right: 1.25rem;
    height: 1px;
    background:
      linear-gradient(90deg, transparent, var(--accent), transparent) 0 0 / 30% 100% no-repeat,
      var(--rule);
  }

  @media (prefers-reduced-motion: no-preference) {
    .steps::before {
      animation: pulse 3.2s var(--ease-in-out) infinite;
    }
  }

  @keyframes pulse {
    from {
      background-position:
        -40% 0,
        0 0;
    }

    to {
      background-position:
        140% 0,
        0 0;
    }
  }

  .steps li {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .node {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: var(--space-2);
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    background: var(--night);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  h3 {
    font-size: var(--text-h3);
  }

  .steps p {
    color: var(--ink-soft);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .code {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-4);
    padding: clamp(var(--space-4), 3vw, var(--space-6));
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--night-raised);
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 60%);
  }

  .pane {
    min-width: 0;
    margin: 0;
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .file {
    color: var(--ink-soft);
  }

  .badge {
    padding: 0 var(--space-2);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .badge--live {
    border-color: color-mix(in srgb, var(--syntax-tag) 60%, transparent);
    color: var(--syntax-tag);
  }

  pre {
    margin: 0;
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--night);
    color: var(--ink);
    font-size: var(--text-xs);
    line-height: 1.7;
    counter-reset: line;
  }

  pre.css {
    margin-top: var(--space-3);
  }

  pre :global(.line) {
    display: block;
    width: max-content;
    min-width: 100%;
  }

  pre :global(.line)::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 2.5rem;
    margin-right: var(--space-3);
    color: var(--syntax-punct);
    text-align: right;
    opacity: 0.6;
  }

  pre :global(.tok-key) {
    color: var(--syntax-key);
  }

  pre :global(.tok-string) {
    color: var(--syntax-string);
  }

  pre :global(.tok-number) {
    color: var(--syntax-number);
  }

  pre :global(.tok-tag) {
    color: var(--syntax-tag);
  }

  pre :global(.tok-punct) {
    color: var(--syntax-punct);
  }

  .render {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
  }

  .fn {
    padding: var(--space-1) var(--space-3);
    border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .beam {
    width: 1px;
    height: var(--space-7);
    background: linear-gradient(var(--rule), var(--accent), var(--rule));
  }

  .note {
    margin-top: var(--space-4);
  }

  @media (max-width: 1000px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--space-7);
    }

    .steps::before {
      display: none;
    }

    .code {
      grid-template-columns: minmax(0, 1fr);
    }

    .render {
      grid-auto-flow: column;
      align-items: center;
    }

    .beam {
      width: var(--space-7);
      height: 1px;
      background: linear-gradient(90deg, var(--rule), var(--accent), var(--rule));
    }
  }

  @media (max-width: 560px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
