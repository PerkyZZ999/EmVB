---
import { externalLinks, nav } from "../data/nav";
import Logo from "./Logo.astro";
import OutlineIcon from "./OutlineIcon.astro";

const github = externalLinks[0];
---

<header class="header" data-outline-skip>
  <div class="wrap bar">
    <a class="brand" href="#top" aria-label="EmVB, back to top">
      <Logo />
      <span>EmVB</span>
    </a>

    <nav class="links" aria-label="Sections">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={github.href}>{github.label}</a>
    </nav>

    <div class="tools">
      <button
        class="outline-toggle"
        type="button"
        aria-pressed="false"
        data-outline-toggle
        hidden
        title="Outline the page the way the EmVB canvas does"
      >
        <OutlineIcon />
        <span class="outline-label">Outline</span>
      </button>
      <a class="button button--ghost cta" href="#get-started">Get started</a>

      <details class="menu">
        <summary>
          <span class="visually-hidden">Menu</span>
          <span class="burger" aria-hidden="true"></span>
        </summary>
        <nav class="sheet" aria-label="Sections">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href={github.href}>{github.label}</a>
          <a href="#get-started">Get started</a>
        </nav>
      </details>
    </div>
  </div>
  <span class="progress" aria-hidden="true"></span>
</header>

<script>
  // Close the mobile sheet after a jump, so it doesn't cover the section it opened.
  const menu = document.querySelector<HTMLDetailsElement>(".header .menu");
  menu?.querySelector(".sheet")?.addEventListener("click", (event) => {
    if ((event.target as Element).closest("a")) menu.open = false;
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper) 84%, transparent);
    backdrop-filter: saturate(1.4) blur(16px);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-lead);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .links {
    display: flex;
    margin-inline-start: auto;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-3);
    border-radius: var(--radius-s);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-in-out);
  }

  .links a:hover {
    color: var(--ink);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .outline-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    border: 1px dashed var(--rule-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-in-out),
      border-color var(--dur-fast) var(--ease-in-out),
      background-color var(--dur-fast) var(--ease-in-out);
  }

  .outline-toggle[hidden] {
    display: none;
  }

  .outline-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .outline-toggle[aria-pressed="true"] {
    border-style: solid;
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }

  .cta {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .cta:hover {
    border-color: var(--accent);
    background: var(--accent-wash);
  }

  .menu {
    display: none;
    position: relative;
  }

  .menu summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 1rem;
    height: 1.5px;
    background: var(--ink);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .burger {
    position: relative;
  }

  .burger::before,
  .burger::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .burger::before {
    top: -5px;
  }

  .burger::after {
    top: 5px;
  }

  .menu[open] .burger {
    background: transparent;
  }

  .menu[open] .burger::before {
    transform: translateY(5px) rotate(45deg);
  }

  .menu[open] .burger::after {
    transform: translateY(-5px) rotate(-45deg);
  }

  .sheet {
    position: absolute;
    top: calc(100% + var(--space-3));
    right: 0;
    display: grid;
    min-width: 14rem;
    padding: var(--space-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--paper-raised);
    box-shadow: var(--shadow-float);
  }

  .sheet a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border-radius: var(--radius-s);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .sheet a:hover {
    background: var(--paper-sunk);
    color: var(--ink);
  }

  /* A reading-progress hairline, driven by the page scroll where the browser supports it. */
  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  @supports (animation-timeline: scroll()) {
    .progress {
      animation: progress linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  @media (max-width: 1100px) {
    .links a:last-child {
      display: none;
    }
  }

  @media (max-width: 960px) {
    .links,
    .cta {
      display: none;
    }

    .tools {
      margin-inline-start: auto;
    }

    .menu {
      display: block;
    }
  }

  @media (max-width: 560px) {
    .outline-label {
      display: none;
    }
  }
</style>
