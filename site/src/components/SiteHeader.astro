---
import { externalLinks, nav } from "../data/nav";
import Logo from "./Logo.astro";
import OutlineIcon from "./OutlineIcon.astro";

const github = externalLinks[0];
---

<header class="header" data-outline-skip>
  <div class="wrap bar">
    <a class="brand" href="/#top" aria-label="EmVB home">
      <Logo />
      <span>EmVB</span>
    </a>

    <nav class="links" aria-label="Sections">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="tools">
      <a class="github" href={github.href} aria-label="EmVB on GitHub" title="EmVB on GitHub">
        <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
      </a>
      <button
        class="outline-toggle"
        type="button"
        aria-pressed="false"
        data-outline-toggle
        hidden
        title="Outline the page the way the EmVB canvas does"
      >
        <OutlineIcon />
        <span class="outline-label">Outline</span>
      </button>
      <a class="button button--ghost cta" href="/#get-started">Get started</a>

      <details class="menu">
        <summary>
          <span class="visually-hidden">Menu</span>
          <span class="burger" aria-hidden="true"></span>
        </summary>
        <nav class="sheet" aria-label="Sections">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href={github.href}>{github.label}</a>
          <a href="/#get-started">Get started</a>
        </nav>
      </details>
    </div>
  </div>
  <span class="progress" aria-hidden="true"></span>
</header>

<script>
  // Close the mobile sheet after a jump, so it doesn't cover the section it opened.
  const menu = document.querySelector<HTMLDetailsElement>(".header .menu");
  menu?.querySelector(".sheet")?.addEventListener("click", (event) => {
    if ((event.target as Element).closest("a")) menu.open = false;
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper) 84%, transparent);
    backdrop-filter: saturate(1.4) blur(16px);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-lead);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .links {
    display: flex;
    margin-inline-start: auto;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-3);
    border-radius: var(--radius-s);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-in-out);
  }

  .links a:hover {
    color: var(--ink);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .outline-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    border: 1px dashed var(--rule-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-in-out),
      border-color var(--dur-fast) var(--ease-in-out),
      background-color var(--dur-fast) var(--ease-in-out);
  }

  .outline-toggle[hidden] {
    display: none;
  }

  .outline-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .outline-toggle[aria-pressed="true"] {
    border-style: solid;
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
  }

  .github {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    color: var(--ink);
    transition:
      color var(--dur-fast) var(--ease-in-out),
      border-color var(--dur-fast) var(--ease-in-out),
      background-color var(--dur-fast) var(--ease-in-out);
  }

  .github:hover {
    border-color: var(--accent);
    background: var(--accent-wash);
    color: var(--accent);
  }

  .github:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .cta {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .cta:hover {
    border-color: var(--accent);
    background: var(--accent-wash);
  }

  .menu {
    display: none;
    position: relative;
  }

  .menu summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 1rem;
    height: 1.5px;
    background: var(--ink);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .burger {
    position: relative;
  }

  .burger::before,
  .burger::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .burger::before {
    top: -5px;
  }

  .burger::after {
    top: 5px;
  }

  .menu[open] .burger {
    background: transparent;
  }

  .menu[open] .burger::before {
    transform: translateY(5px) rotate(45deg);
  }

  .menu[open] .burger::after {
    transform: translateY(-5px) rotate(-45deg);
  }

  .sheet {
    position: absolute;
    top: calc(100% + var(--space-3));
    right: 0;
    display: grid;
    min-width: 14rem;
    padding: var(--space-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--paper-raised);
    box-shadow: var(--shadow-float);
  }

  .sheet a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border-radius: var(--radius-s);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .sheet a:hover {
    background: var(--paper-sunk);
    color: var(--ink);
  }

  /* A reading-progress hairline, driven by the page scroll where the browser supports it. */
  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  @supports (animation-timeline: scroll()) {
    .progress {
      animation: progress linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }

  @media (max-width: 1280px) {
    .links a {
      padding-inline: var(--space-2);
    }
  }

  /* Below this width the seven links and the tools don't fit on one row: the menu takes over. */
  @media (max-width: 1100px) {
    .links,
    .cta {
      display: none;
    }

    .tools {
      margin-inline-start: auto;
    }

    .menu {
      display: block;
    }
  }

  /* The Outline toggle keeps its name for screen readers, but shows only its icon. */
  .outline-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
