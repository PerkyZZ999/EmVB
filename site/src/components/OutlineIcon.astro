---
/** A dashed box with selection handles, for the Outline toggle. */
---

<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <rect
    x="4"
    y="4"
    width="16"
    height="16"
    rx="1"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-dasharray="3 2.5"></rect>
  <rect x="2" y="2" width="4" height="4" rx="0.5" fill="currentColor"></rect>
  <rect x="18" y="2" width="4" height="4" rx="0.5" fill="currentColor"></rect>
  <rect x="2" y="18" width="4" height="4" rx="0.5" fill="currentColor"></rect>
  <rect x="18" y="18" width="4" height="4" rx="0.5" fill="currentColor"></rect>
</svg>
