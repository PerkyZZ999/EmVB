---
/**
 * Outline view: dashed boxes around every block and a named hover outline, drawn in a layer over
 * the page like the EmVB canvas overlay. The header's Outline button turns it on; it only shows
 * once this script runs.
 */
import OutlineIcon from "./OutlineIcon.astro";
---

<div class="outline-layer" data-outline-layer aria-hidden="true" hidden></div>
<div class="outline-status" data-outline-status role="status" hidden>
  <OutlineIcon />
  <p>
    <strong>Outline view.</strong> Each box is labelled with the EmVB element that would build it.
  </p>
  <button type="button" data-outline-off>Turn off</button>
</div>

<script>
  import { BLOCK_SELECTOR, blockLabel } from "../scripts/outline-blocks.ts";

  const toggles = [...document.querySelectorAll<HTMLButtonElement>("[data-outline-toggle]")];
  const layer = document.querySelector<HTMLElement>("[data-outline-layer]");
  const status = document.querySelector<HTMLElement>("[data-outline-status]");
  const off = status?.querySelector<HTMLButtonElement>("[data-outline-off]");

  function place(target: HTMLElement, rect: DOMRect) {
    target.style.left = `${rect.left + window.scrollX}px`;
    target.style.top = `${rect.top + window.scrollY}px`;
    target.style.width = `${rect.width}px`;
    target.style.height = `${rect.height}px`;
  }

  if (layer && status && off && toggles.length > 0) {
    const boxes = document.createElement("div");
    const hover = document.createElement("div");
    const tag = document.createElement("span");
    hover.className = "outline-hover";
    tag.className = "outline-tag";
    hover.append(tag);
    layer.append(boxes, hover);

    const labels = new Map<Element, string>();
    let on = false;
    let frame = 0;
    let hovered: Element | null = null;

    const collect = () => {
      labels.clear();
      for (const el of document.querySelectorAll<HTMLElement>(BLOCK_SELECTOR)) {
        if (el.closest("[data-outline-skip], dialog, .visually-hidden, [data-outline-layer]")) continue;
        if (el.checkVisibility && !el.checkVisibility()) continue;
        const label = blockLabel(el);
        if (label) labels.set(el, label);
      }
    };

    const showHover = () => {
      const label = hovered && labels.get(hovered);
      if (!hovered || !label) {
        hover.hidden = true;
        return;
      }
      hover.hidden = false;
      place(hover, hovered.getBoundingClientRect());
      tag.textContent = `${label}  ${hovered.tagName.toLowerCase()}`;
    };

    const draw = () => {
      frame = 0;
      collect();
      const rects = [...labels.keys()].map((el) => el.getBoundingClientRect());
      const nodes = rects
        .filter((rect) => rect.width > 0 && rect.height > 0)
        .map((rect) => {
          const box = document.createElement("div");
          box.className = "outline-box";
          place(box, rect);
          return box;
        });
      layer.style.height = `${document.documentElement.scrollHeight}px`;
      boxes.replaceChildren(...nodes);
      showHover();
    };

    const schedule = () => {
      if (on && !frame) frame = requestAnimationFrame(draw);
    };

    const pick = (target: EventTarget | null) => {
      let el = target instanceof Element ? target : null;
      while (el && !labels.has(el)) el = el.parentElement;
      if (el !== hovered) {
        hovered = el;
        showHover();
      }
    };

    const onPointer = (event: PointerEvent) => pick(event.target);
    const onFocus = (event: FocusEvent) => pick(event.target);
    const onKey = (event: KeyboardEvent) => {
      if (event.key === "Escape") set(false);
    };
    const observer = new ResizeObserver(schedule);

    const set = (next: boolean) => {
      if (next === on) return;
      on = next;
      layer.hidden = !on;
      status.hidden = !on;
      document.documentElement.toggleAttribute("data-outline", on);
      for (const toggle of toggles) toggle.setAttribute("aria-pressed", String(on));
      if (on) {
        draw();
        observer.observe(document.body);
        document.addEventListener("pointerover", onPointer, { passive: true });
        document.addEventListener("focusin", onFocus);
        document.addEventListener("keydown", onKey);
        window.addEventListener("resize", schedule, { passive: true });
      } else {
        const returnFocus = status.contains(document.activeElement);
        observer.disconnect();
        document.removeEventListener("pointerover", onPointer);
        document.removeEventListener("focusin", onFocus);
        document.removeEventListener("keydown", onKey);
        window.removeEventListener("resize", schedule);
        boxes.replaceChildren();
        hovered = null;
        if (returnFocus) toggles[0]?.focus();
      }
    };

    for (const toggle of toggles) {
      toggle.hidden = false;
      toggle.addEventListener("click", () => set(!on));
    }
    off.addEventListener("click", () => set(false));
  }
</script>

<style is:global>
  .outline-layer {
    position: absolute;
    top: 0;
    left: 0;
    z-index: var(--z-outline);
    width: 100%;
    pointer-events: none;
  }

  .outline-layer[hidden] {
    display: none;
  }

  .outline-box {
    position: absolute;
    border: 1px dashed color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: 2px;
  }

  .outline-hover {
    position: absolute;
    box-shadow:
      inset 0 0 0 1.5px var(--accent),
      0 0 0 1px color-mix(in srgb, var(--accent) 25%, transparent);
    border-radius: 2px;
  }

  .outline-hover[hidden] {
    display: none;
  }

  .outline-tag {
    position: absolute;
    bottom: 100%;
    left: 0;
    padding: 0 var(--space-2);
    border-radius: 4px 4px 4px 0;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: 1.75;
    white-space: pre;
  }

  html[data-outline] main {
    cursor: crosshair;
  }

  .outline-status {
    position: fixed;
    bottom: var(--space-5);
    left: 50%;
    z-index: var(--z-toast);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: max-content;
    max-width: calc(100vw - 2 * var(--space-4));
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-raised);
    box-shadow: var(--shadow-float);
    color: var(--ink-soft);
    font-size: var(--text-sm);
    transform: translateX(-50%);
    animation: outline-status-in var(--dur-base) var(--ease-out);
  }

  .outline-status[hidden] {
    display: none;
  }

  .outline-status svg {
    flex: none;
    color: var(--accent);
  }

  .outline-status strong {
    color: var(--ink);
    font-weight: 600;
  }

  .outline-status button {
    flex: none;
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .outline-status button:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  @keyframes outline-status-in {
    from {
      opacity: 0;
      transform: translate(-50%, var(--space-4));
    }
  }

  @media (max-width: 640px) {
    .outline-status {
      border-radius: var(--radius-m);
    }
  }
</style>
