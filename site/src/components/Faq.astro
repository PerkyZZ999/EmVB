---
import { faqs } from "../data/faq";
import SectionIntro from "./SectionIntro.astro";
---

<section class="section" aria-labelledby="faq-title">
  <div class="wrap narrow" id="faq">
    <SectionIntro id="faq-title" eyebrow="FAQ" title="Questions people ask first" />
    <div class="list" data-el="Accordion">
      {
        faqs.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .narrow {
    max-width: 52rem;
  }

  .list {
    border-top: 1px solid var(--rule-strong);
  }

  details {
    border-bottom: 1px solid var(--rule);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    min-height: 2.75rem;
    padding: var(--space-5) 0;
    font-family: var(--font-display);
    font-size: var(--text-lead);
    cursor: pointer;
    list-style: none;
    transition: color var(--dur-fast) var(--ease-in-out);
  }

  summary:hover {
    color: var(--accent);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: "+";
    flex: none;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-base);
    transition:
      transform var(--dur-base) var(--ease-out),
      background-color var(--dur-fast) var(--ease-in-out),
      color var(--dur-fast) var(--ease-in-out);
  }

  details[open] summary::after {
    background: var(--accent);
    color: var(--accent-ink);
    transform: rotate(45deg);
  }

  details p {
    max-width: 62ch;
    padding-bottom: var(--space-5);
    color: var(--ink-soft);
  }
</style>
