---
import { largestSrc } from "../data/shots";
import type { Spotlight } from "../data/spotlights";
import Frame from "./Frame.astro";
import Shot from "./Shot.astro";

interface Props {
  item: Spotlight;
  index: number;
  total: number;
  flip?: boolean;
}

const { item, index, total, flip = false } = Astro.props;
const detail = item.detail;
const sizes = "(min-width: 1260px) 800px, (min-width: 900px) 64vw, calc(100vw - 2.5rem)";
const count = (n: number) => String(n).padStart(2, "0");
---

<article class:list={["spotlight", "reveal", flip && "spotlight--flip"]}>
  <div class="copy">
    <p class="kicker">
      <span class="count">{count(index)}<span aria-hidden="true"> / {count(total)}</span></span>
      {item.kicker}
    </p>
    <h3>{item.title}</h3>
    <p class="body">{item.body}</p>
    <ul>
      {item.points.map((point) => <li>{point}</li>)}
    </ul>
  </div>
  <div class:list={["visual", detail && "visual--detail"]}>
    <a class="zoom" href={largestSrc(item.shot)} data-lightbox>
      <Frame>
        <Shot id={item.shot} sizes={sizes} />
      </Frame>
      <span class="visually-hidden">Open full size</span>
    </a>
    {
      detail && (
        <figure
          class="detail"
          style={`--x: ${detail.x}; --y: ${detail.y}; --w: ${detail.w}; --h: ${detail.h}`}
        >
          <div class="crop">
            <Shot id={detail.shot} sizes="1200px" />
          </div>
          <figcaption>{detail.label}</figcaption>
        </figure>
      )
    }
  </div>
</article>

<style>
  .spotlight {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    align-items: center;
    gap: clamp(var(--space-6), 5vw, 4.5rem);
  }

  .spotlight--flip {
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
  }

  .spotlight--flip .copy {
    order: 2;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .count {
    padding: 0 var(--space-2);
    border: 1px solid currentColor;
    border-radius: 4px;
    letter-spacing: 0;
    line-height: 1.6;
  }

  h3 {
    margin-top: var(--space-4);
    font-size: var(--text-h3);
  }

  .body {
    margin-top: var(--space-4);
    color: var(--ink-soft);
  }

  ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    padding: var(--space-5) 0 0;
    border-top: 1px solid var(--rule-strong);
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: var(--space-4) 1fr;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  li::before {
    content: "";
    width: 8px;
    height: 8px;
    margin-top: 0.45em;
    border: 1.5px solid var(--accent);
    border-radius: 2px;
  }

  .visual {
    position: relative;
  }

  .zoom {
    display: block;
    border-radius: var(--radius-m);
    cursor: zoom-in;
    transition: box-shadow var(--dur-base) var(--ease-in-out);
  }

  .zoom:hover {
    box-shadow: 0 0 0 1.5px var(--accent);
  }

  .visual--detail {
    padding-bottom: var(--space-8);
  }

  .detail {
    position: absolute;
    bottom: 0;
    left: calc(-1 * var(--space-5));
    width: 34%;
    margin: 0;
    padding: var(--space-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--paper-raised);
    box-shadow: var(--shadow-frame);
  }

  .crop {
    position: relative;
    overflow: hidden;
    aspect-ratio: calc(var(--w) * 1440) / calc(var(--h) * 900);
    border-radius: var(--radius-s);
  }

  .crop :global(img) {
    position: absolute;
    top: calc(-100% * var(--y) / var(--h));
    left: calc(-100% * var(--x) / var(--w));
    width: calc(100% / var(--w));
    max-width: none;
  }

  .detail figcaption {
    padding: var(--space-2) var(--space-2) var(--space-1);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  @media (max-width: 900px) {
    .spotlight,
    .spotlight--flip {
      grid-template-columns: minmax(0, 1fr);
    }

    .spotlight--flip .copy {
      order: 0;
    }

    .detail {
      left: auto;
      right: calc(-1 * var(--space-2));
      width: 42%;
    }
  }
</style>
