{
  "html": "<div class=\"emvb-scope emvb-s-v10-gradient-entrance\"><div class=\"emvb-root emvb-container emvb-e-root0001\"><h1 class=\"emvb-heading emvb-k-glow emvb-e-head0001\">Old page</h1><div class=\"emvb-section\"><p class=\"emvb-text\">Old section</p></div></div></div>",
  "css": ":where(.emvb-scope){display:contents}@keyframes emvb-fade{from{opacity:0}to{opacity:1}}@keyframes emvb-fade-up{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}@keyframes emvb-fade-down{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}@keyframes emvb-slide-up{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}@keyframes emvb-slide-down{from{opacity:0;transform:translateY(-16px)}to{opacity:1;transform:none}}@keyframes emvb-scale{from{opacity:0;transform:scale(0.96)}to{opacity:1;transform:none}}:where(.emvb-s-v10-gradient-entrance) .emvb-root{--emvb-c-ink:#222222}:where(.emvb-s-v10-gradient-entrance) .emvb-container{display:flex;flex-direction:column;min-width:0;overflow-wrap:break-word}:where(.emvb-s-v10-gradient-entrance) :where(a.emvb-box-link){color:inherit;text-decoration:inherit}:where(.emvb-s-v10-gradient-entrance) .emvb-heading{margin:0}:where(.emvb-s-v10-gradient-entrance) .emvb-heading-link{color:inherit;text-decoration:inherit}:where(.emvb-s-v10-gradient-entrance) .emvb-section{display:flex;flex-direction:column;min-width:0}:where(.emvb-s-v10-gradient-entrance) .emvb-text{margin:0}:where(.emvb-s-v10-gradient-entrance) :where(.emvb-text){white-space:pre-line}:where(.emvb-s-v10-gradient-entrance) .emvb-k-glow{animation:emvb-fade-up 400ms ease-out both;background-image:linear-gradient(45deg, #ffffff 0%, var(--emvb-c-ink) 100%)}:where(.emvb-s-v10-gradient-entrance) .emvb-e-root0001{transition:all 200ms ease;background-image:linear-gradient(180deg, #000000 0%, #ffffff 100%)}:where(.emvb-s-v10-gradient-entrance) .emvb-e-head0001{animation:emvb-fade 300ms ease-out both;animation-timeline:view();animation-range:entry 0% cover 40%}@media (prefers-reduced-motion: reduce){:where(.emvb-s-v10-gradient-entrance) .emvb-e-root0001{transition:none}}@media (prefers-reduced-motion: reduce){:where(.emvb-s-v10-gradient-entrance) .emvb-k-glow,:where(.emvb-s-v10-gradient-entrance) .emvb-e-head0001{animation: