{
  "design": {
    "schemaVersion": 10,
    "variables": { "colors": [{ "id": "ink", "name": "Ink", "value": "#222222" }] },
    "classes": [
      {
        "id": "glow",
        "name": "Glow",
        "style": {
          "gradient": { "angle": 45, "from": "#ffffff", "to": { "var": "ink" } },
          "entrance": { "type": "fade-up", "duration": 400 }
        }
      }
    ]
  },
  "layout": {
    "schemaVersion": 10,
    "root": {
      "id": "root0001",
      "type": "container",
      "props": {},
