        "transition": { "duration": 200, "easing": "ease", "property": "all" }
      },
      "children": [
        {
          "id": "head0001",
          "type": "heading",
          "classes": ["glow"],
          "props": { "text": "Old page", "level": 1 },
          "style": { "entrance": { "type": "fade", "duration": 300, "trigger": "view" } }
        },
        {
          "id": "secr0001",
          "type": "section",
          "props": {},
          "children": [{ "id": "text0001", "type": "text", "props": { "text": "Old section" } }]
        }
      ]
    }
  }
}
