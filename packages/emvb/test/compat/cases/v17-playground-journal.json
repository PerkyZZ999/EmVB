            "level": 1
          }
        },
        {
          "id": "pg-j-lede",
          "type": "text",
          "props": {
            "text": "This Loop repeats its item for each post. The playground fills it with a few made-up posts; on a real site they come from EmDash."
          }
        },
        {
          "id": "pg-j-loop",
          "type": "loop",
          "props": {
            "perPage": 6
          },
