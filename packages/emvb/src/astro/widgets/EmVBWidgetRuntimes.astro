---
/**
 * W-1025: the opt-in scripts of the 1.2 widgets, each mounted only when `names` asks for it.
 * `EmVBPage` renders this for its page; for theme parts, pass `theme.runtimes`.
 */
import EmVBAlertsRuntime from "./EmVBAlertsRuntime.astro";
import EmVBCarouselRuntime from "./EmVBCarouselRuntime.astro";
import EmVBCountdownRuntime from "./EmVBCountdownRuntime.astro";
import EmVBCounterRuntime from "./EmVBCounterRuntime.astro";
import EmVBHeadlineRuntime from "./EmVBHeadlineRuntime.astro";
import EmVBLightboxRuntime from "./EmVBLightboxRuntime.astro";
import EmVBMapRuntime from "./EmVBMapRuntime.astro";
import EmVBShareRuntime from "./EmVBShareRuntime.astro";

interface Props {
  names?: readonly string[] | undefined;
}

const names = new Set(Astro.props.names ?? []);
---

{names.has("alerts") && <EmVBAlertsRuntime />}
{names.has("lightbox") && <EmVBLightboxRuntime />}
{names.has("carousel") && <EmVBCarouselRuntime />}
{names.has("counter") && <EmVBCounterRuntime />}
{names.has("countdown") && <EmVBCountdownRuntime />}
{names.has("map") && <EmVBMapRuntime />}
{names.has("headline") && <EmVBHeadlineRuntime />}
{names.has("share") && <EmVBShareRuntime />}
