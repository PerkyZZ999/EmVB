---
// The forms plugin's client script (D-015). Rendered only by hosts that import
// `@perkyzz/emvb/astro/forms/client` and have `@emdash-cms/plugin-forms` installed.
// It loads on pages that contain a form (R-031); other pages never render this component.
// W-1065: EmVB's inline-message and step-focus layer runs after it (./enhance.ts).
---

<script>
  import { initForms } from "@emdash-cms/plugin-forms/client";
  import { enhanceForms } from "./enhance.ts";

  initForms();
  enhanceForms();
</script>
