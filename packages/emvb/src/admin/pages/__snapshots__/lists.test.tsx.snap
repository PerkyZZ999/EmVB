    "Loop item"
  button.emvb-theme-filter aria-controls="emvb-theme-parts-panel" aria-selected="false" id="emvb-theme-filter-section" role="tab" tabindex="-1" type="button"
    "Sections"
  button.emvb-theme-filter aria-controls="emvb-theme-parts-panel" aria-selected="false" id="emvb-theme-filter-page_template" role="tab" tabindex="-1" type="button"
    "Page templates"
  button.emvb-theme-filter aria-controls="emvb-theme-parts-panel" aria-selected="false" id="emvb-theme-filter-popup" role="tab" tabindex="-1" type="button"
    "Popups"
    span.emvb-theme-filter-count.emvb-tabular
      "1"
  button.emvb-theme-filter aria-controls="emvb-theme-parts-panel" aria-selected="false" id="emvb-theme-filter-float" role="tab" tabindex="-1" type="button"
    "Floats"
div.emvb-list-search
  input aria-label="Search theme parts" id="emvb-list-search" placeholder="Search theme parts" type="search" value=""
div aria-labelledby="emvb-theme-filter-all" id="emvb-theme-parts-panel" role="tabpanel"
  div.emvb-surface-card data-emvb-list="theme-parts"
    table data-emvb-list="theme-parts"
      thead
        tr
          th.emvb-row-select
            span aria-checked="false" aria-label="Select all theme parts shown" data-emvb-select-all="" data-unchecked="" role="checkbox" tabindex="0"
              span data-unchecked=""
                svg
                  path
          th
            "Title"
          th
            "Type"
          th
            "Conditions"
          th
            "Status"
          th
            "Last edited"
      tbody
        tr data-emvb-row="01H"
          td.emvb-row-select
            span aria-checked="false" aria-label="Select Main header" data-emvb-select-row="01H" data-unchecked="" role="checkbox" tabindex="0"
              span data-unchecked=""
                svg
                  path
          td
            a.emvb-row-title href="/_emdash/admin/plugins/emvb/editor?entry=01H&collection=emvb_theme_parts"
              "Main header"
          td
            "Header"
          td
            span.emvb-tabular
              "Entire site"
          td
            span.emvb-status data-status="published"
              span.emvb-status-dot aria-hidden="true"
              "Published"
          td
            time.emvb-tabular datetime="2026-09-02T08:30:00.000Z"
              "…"
        tr data-emvb-row="01P"
          td.emvb-row-select
            span aria-checked="false" aria-label="Select Promo" data-emvb-select-row="01P" data-unchecked="" role="checkbox" tabindex="0"
              span data-unchecked=""
                svg
                  path
          td
            a.emvb-row-title href="/_emdash/admin/plugins/emvb/editor?entry=01P&collection=emvb_theme_parts"
              "Promo"
          td
            "Popup"
          td
            span.emvb-tabular
              "No conditions"
          td
            span.emvb-status data-status="draft"
              span.emvb-status-dot aria-hidden="true"
              "Draft"
          td
            time.emvb-tabular datetime=""
              "…""
`;

