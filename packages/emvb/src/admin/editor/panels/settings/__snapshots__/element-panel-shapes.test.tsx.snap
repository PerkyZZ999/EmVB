"div.emvb-panel-body data-emvb-panel="element" data-emvb-element="video"
  div.emvb-element-header
    svg aria-hidden="true"
    h2.emvb-panel-title
      "Video"
  nav.emvb-breadcrumb aria-label="Element path"
    button.emvb-breadcrumb-part type="button"
      "Page"
    span aria-hidden="true"
      "›"
    button.emvb-breadcrumb-part type="button"
      "Container"
    span aria-hidden="true"
      "›"
    button.emvb-breadcrumb-part type="button"
      "Video"
  p.emvb-inline-error role="alert"
    svg aria-hidden="true"
    "Can't go there."
  div.emvb-tabs data-orientation="horizontal" data-activation-direction="none"
    div data-orientation="horizontal" data-activation-direction="none" role="tablist"
      button type="button" data-orientation="horizontal" aria-disabled="false" tabindex="-1" role="tab" aria-selected="false" id="id-0" data-kumo-component="Tabs" data-kumo-part="tab"
        svg aria-hidden="true"
        "Content"
      button type="button" data-orientation="horizontal" aria-disabled="false" tabindex="0" role="tab" aria-selected="true" id="id-1" data-kumo-component="Tabs" data-kumo-part="tab" data-active="" data-composite-item-active=""
        svg aria-hidden="true"
        "Style"
      div data-orientation="horizontal" data-activation-direction="none" role="presentation"
  div.emvb-panel-body data-emvb-tab="style"
    div.emvb-class-field data-emvb-class-picker=""
      label.emvb-field-label for="id-2-input"
        "Classes"
      div.emvb-chip-anchor
        div.emvb-chip-box data-emvb-chip-box="" role="group" aria-label="Classes on this element"
          span.emvb-chip.emvb-chip-local data-emvb-chip-local="" data-active="true"
            button.emvb-chip-main type="button" aria-pressed="true"
              svg aria-hidden="true"
              span.emvb-chip-label
                "Local"
          span.emvb-chip data-emvb-class-id="card" data-active="false"
            button.emvb-chip-main type="button" aria-pressed="false"
              svg aria-hidden="true"
              span.emvb-chip-label
                "card"
            button.emvb-chip-icon type="button" aria-label="Actions for card" tabindex="0" aria-haspopup="menu" id="id-3" aria-expanded="false"
              svg aria-hidden="true"
            button.emvb-chip-icon type="button" tabindex="-1" aria-label="Remove card"
              svg aria-hidden="true"
          input.emvb-chip-text id="id-2-input" data-emvb-class-input="" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="id-2-list" placeholder="Add class…" value=""
      p.emvb-helper data-emvb-cascade-caption=""
        "When two classes set the same property, the one lower in Site styles wins. Local styles still win."
    div.emvb-state-switch data-emvb-state-switch="normal"
      div.emvb-state-tabs data-orientation="horizontal" data-activation-direction="none"
        div
        div data-orientation="horizontal" data-activation-direction="none" role="tablist" aria-label="Style state"
          button type="button" data-active="" data-orientation="horizontal" aria-disabled="false" tabindex="0" role="tab" aria-selected="true" id="id-4" data-composite-item-active="" data-kumo-component="Tabs" data-kumo-part="tab"
            "Normal"
          button type="button" data-orientation="horizontal" aria-disabled="false" tabindex="-1" role="tab" aria-selected="false" id="id-5" data-kumo-component="Tabs" data-kumo-part="tab"
            "Hover"
          button type="button" data-orientation="horizontal" aria-disabled="false" tabindex="-1" role="tab" aria-selected="false" id="id-6" data-kumo-component="Tabs" data-kumo-part="tab"
            "Focus"
          button type="button" data-orientation="horizontal" aria-disabled="false" tabindex="-1" role="tab" aria-selected="false" id="id-7" data-kumo-component="Tabs" data-kumo-part="tab"
            "Active"
          div data-orientation="horizontal" data-activation-direction="none" role="presentation"
    div data-open=""
      button.emvb-section-header type="button" data-panel-open="" tabindex="0" aria-disabled="false" aria-controls="id-8" aria-expanded="true" data-kumo-component="Collapsible" data-kumo-part="trigger" data-emvb-section="spacing"
        span
          "Spacing"
        svg aria-hidden="true"
      div.emvb-section-body data-open="" id="id-8"
        div.emvb-style-row.emvb-box data-emvb-box="padding" data-linked="true" data-unit="px"
        div.emvb-style-row.emvb-box data-emvb-box="margin" data-linked="true" data-unit="px"
    div data-closed=""
      button.emvb-section-header type="button" tabindex="0" aria-disabled="false" aria-expanded="false" data-kumo-component="Collapsible" data-kumo-part="trigger" data-emvb-section="size"
        span
          "Size"
        svg aria-hidden="true"
    div data-closed=""
      button.emvb-section-header type="button" tabindex="0" aria-disabled="false" aria-expanded="false" data-kumo-component="Collapsible" data-kumo-part="trigger" data-emvb-section="position"
        span
          "Position"
        svg aria-hidden="true"
    div data-open=""
      button.emvb-section-header type="button" data-panel-open="" tabindex="0" aria-disabled="false" aria-controls="id-9" aria-expanded="true" data-kumo-component="Collapsible" data-kumo-part="trigger" data-emvb-section="border"
        span
          "Border"
        svg aria-hidden="true"
      div.emvb-section-body data-open="" id="id-9"
        div.emvb-style-row.emvb-box data-emvb-box="borderWidth" data-linked="true" data-unit="px"
        div.emvb-style-row data-emvb-style="borderStyle"
        div.emvb-style-row data-emvb-style="borderColor"
        div.emvb-style-row.emvb-box data-emvb-box="borderRadius" data-linked="true" data-unit="px"
    div data-closed=""
      button.emvb-section-header type="button" tabindex="0" aria-disabled="false" aria-expanded="false" data-kumo-component="Collapsible" data-kumo-part="trigger" data-emvb-section="effects"
        span
          "Effects"
        svg aria-hidden="true"
    div data-open=""
      button.emvb-section-header type="button" data-panel-open="" tabindex="0" aria-disabled="false" aria-controls="id-10" aria-expanded="true" data-kumo-component="Collapsible" data-kumo-part="trigger" data-emvb-section="advanced"
        span
          "Advanced"
        svg aria-hidden="true"
      div.emvb-section-body data-open="" id="id-10"
        div data-filled=""
          label id="id-11" for="id-12" data-filled=""
            span
              "CSS id"
          input.emvb-field.emvb-mono id="id-12" value="hero" data-filled="" aria-labelledby="id-11"
        div.emvb-field-group data-emvb-attributes=""
          span.emvb-var-field-label
            "Attributes"
          button.emvb-btn data-kumo-component="Button" type="button"
            span
              "Add attribute"
          p.emvb-helper
            "data-* and aria-* names only. Event handlers are refused.""
,
}
`;

