exports[`element panel markup (W-021, W-086 M16) loop renders the same content and style tabs 1`] = `
{
  "content": 
"div.emvb-panel-body data-emvb-panel="element" data-emvb-element="loop"
  div.emvb-element-header
    svg aria-hidden="true"
    h2.emvb-panel-title
      "Loop"
  nav.emvb-breadcrumb aria-label="Element path"
    button.emvb-breadcrumb-part type="button"
      "Page"
    span aria-hidden="true"
      "›"
    button.emvb-breadcrumb-part type="button"
      "Container"
    span aria-hidden="true"
      "›"
    button.emvb-breadcrumb-part type="button"
      "Loop"
  p.emvb-inline-error role="alert"
    svg aria-hidden="true"
    "Can't go there."
  div.emvb-tabs data-orientation="horizontal" data-activation-direction="none"
    div data-orientation="horizontal" data-activation-direction="none" role="tablist"
      button type="button" data-active="" data-orientation="horizontal" aria-disabled="false" tabindex="0" role="tab" aria-selected="true" id="id-0" data-composite-item-active="" data-kumo-component="Tabs" data-kumo-part="tab"
        svg aria-hidden="true"
        "Content"
      button type="button" data-orientation="horizontal" aria-disabled="false" tabindex="-1" role="tab" aria-selected="false" id="id-1" data-kumo-component="Tabs" data-kumo-part="tab"
        svg aria-hidden="true"
        "Style"
      div data-orientation="horizontal" data-activation-direction="none" role="presentation"
  div.emvb-panel-body data-emvb-tab="content"
    div data-emvb-loop-item-bind="manual"
      div
        label id="id-2" for="id-3"
          span
            "Loop Item part id"
        input.emvb-field.emvb-mono id="id-3" value="" aria-labelledby="id-2"
      p.emvb-helper
        "No Loop Item theme parts yet. Paste an id, or"
        a href="/_emdash/admin/plugins/emvb/theme"
          "create one in Theme Builder"
        "."
    div
      label id="id-4" for="id-5"
        span
          "Posts per page"
      input.emvb-field.emvb-mono id="id-5" data-emvb-field="perPage" value="" aria-labelledby="id-4"
    p.emvb-helper data-emvb-loop-note="true"
      "A Loop lists posts only in an Archive template. Here the editor shows sample posts, but the live page shows nothing. Build post lists in Theme Builder › Archive.""
,
  "style": 
"div.emvb-panel-body data-emvb-panel="element" data-emvb-element="loop"
  div.emvb-element-header
