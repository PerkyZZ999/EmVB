{
  "content": 
"div.emvb-panel-body data-emvb-element="flexbox" data-emvb-panel="element"
  div.emvb-element-header
    svg aria-hidden="true"
    h2.emvb-panel-title
      "Flexbox"
  nav.emvb-breadcrumb aria-label="Element path"
    button.emvb-breadcrumb-part type="button"
      "Page"
    span aria-hidden="true"
      "›"
    button.emvb-breadcrumb-part type="button"
      "Container"
    span aria-hidden="true"
      "›"
    span.emvb-breadcrumb-current aria-current="location"
      "Flexbox"
  p.emvb-inline-error role="alert"
    svg aria-hidden="true"
    "Can't go there."
  div.emvb-tabs
    div role="tablist"
      button aria-selected="false" role="tab" tabindex="-1" type="button"
        svg aria-hidden="true"
        "Content"
      button aria-selected="true" data-active="" data-composite-item-active="" role="tab" tabindex="0" type="button"
        svg aria-hidden="true"
        "Style"
      div role="presentation"
  div.emvb-panel-body data-emvb-tab="style"
    div.emvb-class-field data-emvb-class-picker=""
      label.emvb-field-label for="(generated)-input"
        "Classes"
      div.emvb-chip-anchor
        div.emvb-chip-box aria-label="Classes on this element" data-emvb-chip-box="" role="group"
          span.emvb-chip.emvb-chip-local data-active="true" data-emvb-chip-local=""
            button.emvb-chip-main aria-pressed="true" type="button"
              svg aria-hidden="true"
              span.emvb-chip-label
                "Local"
          span.emvb-chip data-active="false" data-emvb-class-id="card" data-missing=""
            button.emvb-chip-main aria-pressed="false" type="button"
              svg aria-hidden="true"
              span.emvb-chip-label
                "Missing (card)"
            button.emvb-chip-icon aria-expanded="false" aria-haspopup="menu" aria-label="Actions for missing class card" tabindex="0" type="button"
              svg aria-hidden="true"
            button.emvb-chip-icon aria-label="Remove missing class card" tabindex="-1" type="button"
              svg aria-hidden="true"
          input.emvb-chip-text aria-autocomplete="list" aria-controls="(generated)-list" aria-expanded="false" data-emvb-class-input="" id="(generated)-input" placeholder="Add class…" role="combobox" value=""
      button.emvb-link-button.emvb-save-local data-emvb-save-local="" type="button"
        "Save local styles as class"
    div.emvb-state-switch data-emvb-state-switch="normal"
      div.emvb-state-tabs
        div aria-label="Style state" role="tablist"
          button aria-selected="true" data-active="" data-composite-item-active="" role="tab" tabindex="0" type="button"
            "Normal"
          button aria-selected="false" role="tab" tabindex="-1" type="button"
            "Hover"
          button aria-selected="false" role="tab" tabindex="-1" type="button"
            "Focus"
          button aria-selected="false" role="tab" tabindex="-1" type="button"
            "Active"
          div role="presentation"
    details.emvb-sources data-emvb-style-sources=""
      summary
        span.emvb-sources-label
          "Where styles come from"
        span.emvb-sources-count
          "3 set"
          svg.emvb-sources-caret aria-hidden="true"
      ul
        li data-emvb-source="flexDirection" data-kind="local"
          span.emvb-sources-prop
            "Flex direction"
          span.emvb-sources-value
            "row"
          span.emvb-sources-from
            "This element"
        li data-emvb-source="flexWrap" data-kind="local"
          span.emvb-sources-prop
            "Flex wrap"
          span.emvb-sources-value
            "wrap"
          span.emvb-sources-from
            "This element"
        li data-emvb-source="gap" data-kind="local"
          span.emvb-sources-prop
            "Gap"
          span.emvb-sources-value
            "16px"
          span.emvb-sources-from
            "This element"
    div data-open=""
      button.emvb-section-header aria-controls="(generated)" aria-expanded="true" data-emvb-section="layout" tabindex="0" type="button"
        "Layout"
        svg aria-hidden="true"
      div.emvb-section-body data-open=""
        div.emvb-style-row data-emvb-style="flexDirection" data-set="true"
        div.emvb-style-row data-emvb-style="flexWrap" data-set="true"
        div.emvb-style-row data-emvb-style="justifyContent"
        div.emvb-style-row data-emvb-style="alignItems"
        div.emvb-style-row data-emvb-style="gap" data-set="true" data-unit="px"
    div data-open=""
      button.emvb-section-header aria-controls="(generated)" aria-expanded="true" data-emvb-section="spacing" tabindex="0" type="button"
        "Spacing"
        svg aria-hidden="true"
      div.emvb-section-body data-open=""
        div.emvb-style-row.emvb-box data-emvb-box="padding" data-linked="true" data-unit="px"
        div.emvb-style-row.emvb-box data-emvb-box="margin" data-linked="true" data-unit="px"
    div data-closed=""
      button.emvb-section-header aria-expanded="false" data-emvb-section="size" tabindex="0" type="button"
        "Size"
        svg aria-hidden="true"
    div data-closed=""
      button.emvb-section-header aria-expanded="false" data-emvb-section="position" tabindex="0" type="button"
        "Position"
        svg aria-hidden="true"
    div data-open=""
      button.emvb-section-header aria-controls="(generated)" aria-expanded="true" data-emvb-section="typography" tabindex="0" type="button"
        "Typography"
        svg aria-hidden="true"
      div.emvb-section-body data-open=""
        div.emvb-style-row data-emvb-style="fontFamily"
        div.emvb-style-row data-emvb-style="fontSize" data-unit="px"
        div.emvb-style-row data-emvb-style="fontWeight"
        div.emvb-style-row data-emvb-style="lineHeight" data-unit="em"
        div.emvb-style-row data-emvb-style="letterSpacing" data-unit="px"
        div.emvb-style-row data-emvb-style="textAlign"
        div.emvb-style-row data-emvb-style="textTransform"
        div.emvb-style-row data-emvb-style="textDecoration"
        div.emvb-style-row data-emvb-style="fontStyle"
        div.emvb-style-row data-emvb-style="whiteSpace"
        div.emvb-style-row data-emvb-style="overflowWrap"
        div.emvb-style-row data-emvb-style="color"
    div data-open=""
      button.emvb-section-header aria-controls="(generated)" aria-expanded="true" data-emvb-section="background" tabindex="0" type="button"
        "Background"
        svg aria-hidden="true"
      div.emvb-section-body data-open=""
        div.emvb-style-row data-emvb-style="backgroundColor"
    div data-open=""
      button.emvb-section-header aria-controls="(generated)" aria-expanded="true" data-emvb-section="border" tabindex="0" type="button"
        "Border"
        svg aria-hidden="true"
      div.emvb-section-body data-open=""
        div.emvb-style-row.emvb-box data-emvb-box="borderWidth" data-linked="true" data-unit="px"
        div.emvb-style-row data-emvb-style="borderStyle"
        div.emvb-style-row data-emvb-style="borderColor"
        div.emvb-style-row.emvb-box data-emvb-box="borderRadius" data-linked="true" data-unit="px"
    div data-closed=""
      button.emvb-section-header aria-expanded="false" data-emvb-section="effects" tabindex="0" type="button"
        "Effects"
        svg aria-hidden="true"
    div data-open=""
      button.emvb-section-header aria-controls="(generated)" aria-expanded="true" data-emvb-section="advanced" tabindex="0" type="button"
        "Advanced"
        svg aria-hidden="true"
      div.emvb-section-body data-open=""
        div data-filled=""
          label data-filled="" for="(generated)"
            "CSS id"
          input.emvb-field.emvb-mono aria-labelledby="(generated)" data-filled="" value="hero"
        div data-filled=""
          div data-filled=""
            "Text direction"
          button.emvb-field aria-expanded="false" aria-haspopup="listbox" aria-label="Text direction" data-filled="" role="combobox" tabindex="0" type="button"
            "Site default"
            span aria-hidden="true"
              svg
        div.emvb-field-group data-emvb-container=""
          label.emvb-check
            input type="checkbox"
            "Query container"
          label for="(generated)"
            "Styles from container width (px)"
          input.emvb-field aria-labelledby="(generated)" data-emvb-query-min="" value=""
          button.emvb-btn data-emvb-query-copy="" type="button"
            "Use current style at that width"
          p.emvb-helper
            "Query container makes this box the size children measure. The styles listed here apply inside @container once the container is at least that wide, not the viewport."
        div.emvb-field-group data-emvb-attributes=""
          span.emvb-var-field-label
            "Attributes"
          button.emvb-btn type="button"
            "Add attribute"
          p.emvb-helper
            "data-* and aria-* names only. Event handlers are refused.""
,
