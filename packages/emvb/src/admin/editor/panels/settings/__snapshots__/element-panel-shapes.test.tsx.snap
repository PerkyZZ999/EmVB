    label for="(generated)"
      "Collection"
    input.emvb-field aria-describedby="(generated)" aria-labelledby="(generated)" data-emvb-field="collection" value=""
    p
      "A collection's slug, such as posts or team, lists its entries on any page. Leave it empty on an Archive part to list the archive's posts."
    div data-emvb-field="display"
      div data-filled=""
        div data-filled=""
          "Show as"
