          "List"
          span aria-hidden="true"
            svg
    label for="(generated)"
      "Entries to show"
    input.emvb-field.emvb-mono aria-describedby="(generated)" aria-labelledby="(generated)" data-emvb-field="limit" value=""
    p
      "1 to 50 entries from the collection. Leave it empty for 6."
    div data-emvb-field="order"
      div data-filled=""
        div data-filled=""
          "Order"
        button.emvb-field aria-expanded="false" aria-haspopup="listbox" aria-label="Order" data-filled="" role="combobox" tabindex="0" type="button"
          "Newest first"
          span aria-hidden="true"
            svg
