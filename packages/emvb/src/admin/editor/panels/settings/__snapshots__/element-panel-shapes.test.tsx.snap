    div role="tablist"
      button aria-selected="true" data-active="" data-composite-item-active="" role="tab" tabindex="0" type="button"
        svg aria-hidden="true"
        "Content"
      button aria-selected="false" role="tab" tabindex="-1" type="button"
        svg aria-hidden="true"
        "Style"
      div role="presentation"
