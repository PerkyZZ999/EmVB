exports[`element panel markup (W-021, W-086 M16) grid renders the same content and style tabs 1`] = `
{
  "content": 
"div.emvb-panel-body data-emvb-element="grid" data-emvb-panel="element"
  div.emvb-element-header
    svg aria-hidden="true"
    h2.emvb-panel-title
      "Grid"
  nav.emvb-breadcrumb aria-label="Element path"
    button.emvb-breadcrumb-part type="button"
      "Page"
    span aria-hidden="true"
      "›"
    button.emvb-breadcrumb-part type="button"
      "Container"
    span aria-hidden="true"
      "›"
    span.emvb-breadcrumb-current aria-current="location"
      "Grid"
  p.emvb-inline-error role="alert"
    svg aria-hidden="true"
    "Can't go there."
  div.emvb-tabs
    div role="tablist"
      button aria-selected="true" data-active="" data-composite-item-active="" role="tab" tabindex="0" type="button"
        svg aria-hidden="true"
        "Content"
      button aria-selected="false" role="tab" tabindex="-1" type="button"
        svg aria-hidden="true"
        "Style"
      div role="presentation"
  div.emvb-panel-body data-emvb-tab="content"
    div data-emvb-field="columns"
      div data-filled=""
        div data-filled=""
          "Columns"
        button.emvb-field aria-expanded="false" aria-haspopup="listbox" aria-label="Columns" data-filled="" role="combobox" tabindex="0" type="button"
          "3"
          span aria-hidden="true"
            svg
    div.emvb-field-group data-emvb-field="columnTracks"
      label.emvb-field-label for="(generated)"
        "Custom tracks"
      textarea.emvb-field.emvb-textarea aria-describedby="(generated)-hint"
      span.emvb-helper data-emvb-field-hint="" id="(generated)-hint"
        "Up to 12 tracks, one per line: 1fr, 2fr, 3fr, auto, min-content, max-content, or a length."
    label for="(generated)"
      "Link"
    input.emvb-field aria-labelledby="(generated)" data-emvb-field="href" value=""
    section.emvb-bind aria-labelledby="emvb-bind-keys-bi1nwpcq-title" data-emvb-bindings=""
      h3.emvb-bind-title id="emvb-bind-keys-bi1nwpcq-title"
        "Dynamic data"
      p.emvb-helper
        "Show live data instead of the typed value. The typed value is used when there is none."
      div.emvb-bind-row data-emvb-bind-field="href"
        label.emvb-bind-label id="emvb-bind-keys-bi1nwpcq-href-label"
          "Link source"
        span.emvb-panel-select data-emvb-bind-source="href" data-value="static"
          button.emvb-field aria-expanded="false" aria-haspopup="listbox" aria-labelledby="emvb-bind-keys-bi1nwpcq-href-label" role="combobox" tabindex="0" type="button"
            "Typed value"
            span aria-hidden="true"
              svg
    section.emvb-bind aria-labelledby="emvb-aud-bi1nwpcq-title" data-emvb-audience-editor=""
      h3.emvb-bind-title id="emvb-aud-bi1nwpcq-title"
        "Visitors"
      div.emvb-bind-row
        span.emvb-bind-label id="emvb-aud-bi1nwpcq-show"
          "Show to"
        span.emvb-panel-select data-emvb-audience-mode="" data-value="everyone"
          button.emvb-field aria-expanded="false" aria-haspopup="listbox" aria-labelledby="emvb-aud-bi1nwpcq-show" role="combobox" tabindex="0" type="button"
            "Everyone"
            span aria-hidden="true"
              svg"
,
