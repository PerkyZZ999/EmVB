    p
      "Where each entry links, such as /team/{slug}; {slug} and {id} are filled in. Leave it empty for /collection/{slug}."
    label for="(generated)"
      "Image field"
    input.emvb-field aria-describedby="(generated)" aria-labelledby="(generated)" data-emvb-field="imageField" value=""
    p
