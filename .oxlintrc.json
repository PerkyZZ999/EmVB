            "patterns": [
              {
                "group": [
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*",
                  "astro",
                  "astro/*",
                  "astro:*",
                  "emdash",
                  "emdash/*",
                  "@emdash-cms/*",
                  "@cloudflare/*",
                  "node:*"
                ],
                "message": "src/core must stay framework- and runtime-free (D-014, D-021)."
              }
            ]
