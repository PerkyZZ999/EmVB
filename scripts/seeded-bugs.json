      "edits": [
        {
          "file": "packages/emvb/src/core/sanitize/css.ts",
          "search": "return value.length > 0 && value.length <= 200 && !FORBIDDEN.test(value) && !/[\\n\\r]/.test(value);",
          "replace": "return value.length > 0;"
        }
      ],
      "command": [
        "bun",
        "test",
        "./packages/emvb/src/core"
      ],
      "expect": "\\(fail\\).*the generic guard rejects"
    },
    {
      "id": "W-005/heading-always-h2",
      "requirement": "R-011",
