          "search": "for (const type of [...usedTypes].toSorted()) parts.push(baseCss.get(type) ?? \"\");",
          "replace": "for (const css of baseCss.values()) parts.push(css);"
        }
      ],
      "command": [
        "bun",
        "test",
        "./packages/emvb/src/core"
      ],
      "expect": "\\(fail\\).*base CSS is emitted only"
    },
    {
      "id": "W-005/slow-render",
      "requirement": "N-002",
      "description": "renderPage takes 25 ms per call",
      "edits": [
        {
          "file": "packages/emvb/src/core/render/index.ts",
          "search": "const mode = opts.mode ?? \"public\";",
          "replace": "const mode = opts.mode ?? \"public\";\n  const until = performance.now() + 25;\n  while (performance.now() < until);"
        }
      ],
      "command": [
        "bun",
        "run",
        "bench:render"
      ],
      "expect": "renderPage, 300 nodes, 200 runs: median 2\\d\\.\\d+ ms"
    },
    {
      "id": "W-006/role-check-removed",
      "requirement": "D-020",
      "description": "the beforeSave role check accepts every role",
      "edits": [
        {
          "file": "packages/emvb/src/server/hooks.ts",
          "search": "if (event.actor && event.actor.role < EDITOR_ROLE) {",
          "replace": "if (event.actor && event.actor.role < 0) {"
        }
      ],
      "command": [
        "bun",
        "test",
        "./packages/emvb/test/server"
      ],
      "expect": "\\(fail\\).*a save by role 10 is rejected"
    },
    {
      "id": "W-006/hook-validation-skipped",
      "requirement": "R-006",
      "description": "the beforeSave hook no longer validates layouts",
      "edits": [
        {
          "file": "packages/emvb/src/server/hooks.ts",
          "search": "if (event.content[\"layout\"] === undefined) return;",
          "replace": "return;"
        }
      ],
      "command": [
        "bun",
        "test",
        "./packages/emvb/test/server"
      ],
      "expect": "\\(fail\\).*an invalid layout is rejected with SAVE_REJECTED"
