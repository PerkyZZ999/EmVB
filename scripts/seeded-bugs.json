    {
      "id": "W-006/size-precheck-removed",
      "requirement": "N-005",
      "description": "the design save no longer checks the size before CAS",
      "edits": [
        {
          "file": "packages/emvb/src/server/design-routes.ts",
          "search": "if (bytes > MAX_DESIGN_BYTES) {",
          "replace": "if (bytes > MAX_DESIGN_BYTES * 8) {"
        }
      ],
      "command": [
        "bun",
        "test",
        "./packages/emvb/test/server"
      ],
      "expect": "\\(fail\\).*256 KiB \\+ 1 byte gets 413"
