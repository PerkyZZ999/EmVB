    {
      "id": "W-006/cas-replaced-by-put",
      "requirement": "D-013",
      "description": "the design save overwrites with put instead of compare-and-set",
      "edits": [
        {
          "file": "packages/emvb/src/server/design-routes.ts",
          "search": "const write = await store(ctx).compareAndSet(DESIGN_KEY, ctx.input.revision, result.design);",
          "replace": "await (ctx.storage[\"design\"] as unknown as { put(id: string, v: unknown): Promise<void> }).put(DESIGN_KEY, result.design);\n    const write = { applied: true as const, revision: crypto.randomUUID() };"
        }
      ],
      "command": [
        "bun",
        "test",
        "./packages/emvb/test/server"
      ],
      "expect": "\\(fail\\).*a stale revision gets 409"
