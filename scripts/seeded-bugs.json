    {
      "id": "W-006/hook-logs-content",
      "requirement": "N-008",
      "description": "the rejection log includes the layout",
      "edits": [
        {
          "file": "packages/emvb/src/server/hooks.ts",
          "search": "ctx.log.warn(\"emvb: page save rejected\", { pageId, code: result.issues[0]?.code ?? \"invalid\" });",
          "replace": "ctx.log.warn(\"emvb: page save rejected\", { pageId, code: result.issues[0]?.code ?? \"invalid\", layout: event.content[\"layout\"] });"
        }
      ],
      "command": [
        "bun",
        "test",
        "./packages/emvb/test/server"
      ],
      "expect": "\\(fail\\).*no layout content"
